# Python / uv
# uv.lock here resolves against the Databricks internal PyPI proxy (per
# ~/.config/uv), so it carries non-portable internal URLs. We don't commit it:
# CI resolves from public PyPI. Regenerate a committable lock from an off-proxy
# environment if fully hermetic pinning is needed later.
uv.lock
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
/dist/
/build/
*.egg-info/

# Databricks
.databricks/

# Local data / scratch (never commit wafer data or model artifacts)
/data/
/scratch/
*.npz
*.ckpt
*.pt

# OS
.DS_Store

# local MLflow tracking store created by mlflow client calls
mlflow.db

# Vue app build artefacts (rebuilt by Databricks Apps from app/package.json)
app/node_modules/
app/frontend/dist/
# lockfile would pin internal npm-proxy URLs; Apps resolves from public npm
app/package-lock.json
